{
	"name": "react-antd-admin",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@11.24.0",
	"description": "React Hooks + TypeScript + Ant Design = react-antd-admin",
	"author": "Condor Hero",
	"license": "MIT",
	"homepage": "https://github.com/condorheroblog/react-antd-admin/blob/main/README.md",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/condorheroblog/react-antd-admin.git"
	},
	"bugs": {
		"url": "https://github.com/condorheroblog/react-antd-admin/issues"
	},
	"imports": {
		"#src/*": "./packages/runtime/src/*",
		"#*": "./*"
	},
	"scripts": {
		"dev": "vite --host",
		"build": "NODE_OPTIONS=--max-old-space-size=8192 vite build && tsx scripts/build-modules.ts",
		"build:framework": "vite build",
		"build:modules": "tsx scripts/build-modules.ts",
		"create:module": "tsx scripts/create-module.ts",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"analyzer": "vite-bundle-visualizer --output analyzer/stats.html",
		"eslint-config-inspector": "eslint-config-inspector",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepare": "simple-git-hooks",
		"pnpm:install": "pnpm install",
		"npm-check": "taze major -lrw",
		"check:circular-deps": "ds packages/runtime/src --output circular-deps.json",
		"test": "vitest"
	},
	"dependencies": {
		"@ant-design/icons": "catalog:",
		"@ant-design/pro-components": "catalog:",
		"@dnd-kit/core": "catalog:",
		"@dnd-kit/sortable": "catalog:",
		"@dnd-kit/utilities": "catalog:",
		"@tanstack/react-query": "catalog:",
		"ahooks": "catalog:",
		"antd": "catalog:",
		"antd-img-crop": "catalog:",
		"dayjs": "catalog:",
		"echarts": "catalog:",
		"echarts-for-react": "catalog:",
		"i18next": "catalog:",
		"keepalive-for-react": "catalog:",
		"ky": "catalog:",
		"motion": "catalog:",
		"nprogress": "catalog:",
		"pinyin-pro": "catalog:",
		"react": "catalog:",
		"react-countup": "catalog:",
		"react-dom": "catalog:",
		"react-error-boundary": "catalog:",
		"react-i18next": "catalog:",
		"react-jss": "catalog:",
		"react-router": "catalog:",
		"simplebar-react": "catalog:",
		"spin-delay": "catalog:",
		"tailwind-merge": "catalog:",
		"zustand": "catalog:"
	},
	"devDependencies": {
		"@ant-design/cssinjs": "catalog:",
		"@antfu/eslint-config": "^9.0.0",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@eslint-react/eslint-plugin": "^5.7.9",
		"@eslint/config-inspector": "^3.0.2",
		"@faker-js/faker": "^10.4.0",
		"@iconify-json/ri": "^1.2.10",
		"@iconify/tools": "^5.0.11",
		"@svgr/plugin-jsx": "^8.1.0",
		"@svgr/plugin-svgo": "^8.1.0",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/react-query-devtools": "^5.100.10",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^25.8.0",
		"@types/nprogress": "^0.2.3",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"circular-dependency-scanner": "^3.0.1",
		"clsx": "catalog:",
		"code-inspector-plugin": "^1.5.1",
		"esbuild": "^0.28.2",
		"eslint": "^10.4.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.6.0",
		"happy-dom": "^20.9.0",
		"lint-staged": "^17.0.4",
		"simple-git-hooks": "^2.13.1",
		"tailwindcss": "^4.3.0",
		"taze": "^19.12.0",
		"tsx": "^4.23.12",
		"typescript": "catalog:",
		"unplugin-icons": "^23.0.1",
		"use-sync-external-store": "catalog:",
		"vite": "^8.0.13",
		"vite-bundle-visualizer": "^1.2.1",
		"vite-plugin-checker": "^0.13.0",
		"vite-plugin-fake-server": "^2.2.4",
		"vite-plugin-svgr": "^5.2.0",
		"vitest": "^4.1.6"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged",
		"commit-msg": "npx commitlint --edit"
	},
	"lint-staged": {
		"*": [
			"eslint --fix"
		]
	}
}
