{
	"name": "@react-antd-module/runtime",
	"type": "module",
	"version": "0.1.0",
	"description": "React Antd Admin 框架运行时，供模块工程消费",
	"license": "MIT",
	"imports": {
		"#src/*": "./src/*",
		"#modules/*": "../../modules/*",
		"#manifest.json": "../../manifest.json"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/runtime.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build && tsc -p tsconfig.dts.json && node scripts/rewrite-dts-specifiers.mjs && node scripts/inline-css.mjs"
	},
	"peerDependencies": {
		"@ant-design/icons": "catalog:",
		"@ant-design/pro-components": "catalog:",
		"@dnd-kit/core": "catalog:",
		"@dnd-kit/sortable": "catalog:",
		"@dnd-kit/utilities": "catalog:",
		"@react-antd-module/contract": "workspace:*",
		"ahooks": "catalog:",
		"antd": "catalog:",
		"antd-img-crop": "catalog:",
		"clsx": "catalog:",
		"i18next": "catalog:",
		"keepalive-for-react": "catalog:",
		"ky": "catalog:",
		"motion": "catalog:",
		"nprogress": "catalog:",
		"pinyin-pro": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-error-boundary": "catalog:",
		"react-i18next": "catalog:",
		"react-jss": "catalog:",
		"react-router": "catalog:",
		"simplebar-react": "catalog:",
		"spin-delay": "catalog:",
		"tailwind-merge": "catalog:",
		"zustand": "catalog:"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@iconify-json/ri": "catalog:",
		"@iconify/tools": "catalog:",
		"unplugin-icons": "catalog:"
	}
}
