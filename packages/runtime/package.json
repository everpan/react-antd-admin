{
	"name": "@react-antd-admin/runtime",
	"type": "module",
	"version": "0.0.0",
	"description": "React Antd Admin 框架运行时，供模块工程消费",
	"license": "MIT",
	"imports": {
		"#src/*": "./src/*",
		"#modules/*": "../../modules/*",
		"#manifest.json": "../../manifest.json"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/runtime.js"
