	],
	"scripts": {
		"build": "vite build && tsc -p tsconfig.dts.json && node scripts/rewrite-dts-specifiers.mjs"
	},
	"peerDependencies": {
		"@ant-design/icons": "^6.2.3",
		"@ant-design/pro-components": "^3.1.12-0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"ahooks": "^3.9.7",
		"antd": "^6.4.2",
		"antd-img-crop": "^4.30.0",
		"clsx": "^2.1.1",
		"i18next": "^26.2.0",
		"keepalive-for-react": "^5.0.11",
		"ky": "^2.0.2",
		"motion": "^12.38.0",
		"nprogress": "^0.2.0",
		"pinyin-pro": "^3.28.1",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-error-boundary": "^6.1.1",
		"react-i18next": "^17.0.8",
		"react-jss": "^10.10.0",
		"react-router": "^7.15.1",
		"simplebar-react": "^3.3.2",
		"spin-delay": "^2.0.1",
		"tailwind-merge": "^3.6.0",
		"zustand": "^5.0.13"
