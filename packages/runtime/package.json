{
	"name": "@react-antd-admin/runtime",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"description": "React Antd Admin 框架运行时，供模块工程消费",
	"license": "MIT",
	"imports": {
		"#src/*": "./src/*",
		"#modules/*": "../../modules/*",
		"#manifest.json": "../../manifest.json"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/runtime.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build && tsc -p tsconfig.dts.json && node scripts/rewrite-dts-specifiers.mjs"
	},
	"peerDependencies": {
		"antd": "^6.4.2",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-router": "^7.15.1"
	}
}
