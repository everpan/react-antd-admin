{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"rootDir": "src",
		"paths": {
			"#src/*": ["./src/*"],
			"#*": ["../../*"]
		},
		"declaration": true,
		"declarationMap": false,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"outDir": "dist"
	},
	"include": ["src/index.ts", "src/types"]
}
