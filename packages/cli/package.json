{
	"name": "@react-antd-module/cli",
	"type": "module",
	"version": "0.0.0",
	"description": "React Antd Admin 模块工程命令行工具",
	"license": "MIT",
	"exports": {
		".": "./src/index.ts",
		"./build": "./src/build.ts",
		"./shared-deps": "./src/shared-deps.ts",
		"./esm-exports": "./src/esm-exports.ts",
		"./config": "./src/config.ts",
		"./manifest": "./src/manifest.ts",
		"./info": "./src/info.ts"
	},
	"bin": {
		"ram": "./bin/ram.mjs"
	},
	"files": [
		"bin",
		"src",
		"templates",
		"vendor"
	],
	"dependencies": {
		"esbuild": "catalog:",
		"tsx": "catalog:",
		"vite": "catalog:"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	}
